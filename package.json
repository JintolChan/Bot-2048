{
  "name": "bot-chain-2048",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "contracts:build": "node scripts/compile.mjs",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write src scripts test vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "hardhat": "^3.17.0",
    "prettier": "^3.9.9",
    "solc": "0.8.28",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "solc": {
      "tmp": "^0.2.6"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
